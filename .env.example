VITE_SUPABASE_URL=https://oqxcokxpyoxsgxbxyema.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-anon-public-key

# Backend/Laravel only. Never expose this in React or any VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key

# Laravel backend PostgreSQL connection.
# Copy these into backend/.env and fill in the Supabase database password.
LARAVEL_DB_CONNECTION=pgsql
LARAVEL_DB_HOST=db.oqxcokxpyoxsgxbxyema.supabase.co
LARAVEL_DB_PORT=5432
LARAVEL_DB_DATABASE=postgres
LARAVEL_DB_USERNAME=postgres
LARAVEL_DB_PASSWORD=replace-with-supabase-db-password
LARAVEL_DB_SSLMODE=require
